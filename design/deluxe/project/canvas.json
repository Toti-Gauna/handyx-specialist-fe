      "y": 28726,
      "w": 380,
      "size": 24,
      "fill": "green",
      "text": "Antes y después en dos vistas; informe que se completa solo con conformidad, garantía y recordatorio."
    },
    "titulo9": {
      "x": 0,
      "y": 29690,
      "text": "H0 · Tu equipamiento",
      "kind": "title1",
      "maxW": 1410,
      "w": 240

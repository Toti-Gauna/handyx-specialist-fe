      "y": 30954,
      "text": "R · Ferretería (app del profesional)",
      "kind": "title1",
      "maxW": 3290,
      "w": 240
    },
    "nota10": {
      "x": 3330,
      "y": 31254,
      "w": 380,
      "size": 24,

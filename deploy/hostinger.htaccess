# Handyx specialist app Hostinger managed static export
# La primera línea es una marca: scripts/hostinger-publish.sh solo reemplaza un .htaccess que la tenga (no pisa uno ajeno).
# Hostinger (LiteSpeed/Apache): app de especialistas en la raíz de workers.handyx.pro (export estático de Next, trailingSlash).
# Cada ruta es carpeta/index.html: no hace falta reescribir. DirectoryIndex tiene prioridad sobre default.php.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # Lo que una <meta> no puede fijar. La CSP completa (hashes por build) queda para la Fase 5 (ADR-0001).
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  # La app no usa ubicación, micrófono ni cámara.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # No se indexa (el layout ya lo pide con <meta robots>). Quitar al lanzar públicamente.
  Header always set X-Robots-Tag "noindex, nofollow"
  # Solo activar HSTS cuando el dominio y HTTPS estén verificados.
  # Header always set Strict-Transport-Security "max-age=31536000"

  # El HTML y los datos de página cambian en cada release: siempre se revalidan.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  # _next/static lleva su propio .htaccess (deploy/hostinger-static.htaccess): LiteSpeed no soporta <If>.
</IfModule>

# Todas las variables NEXT_PUBLIC_* se compilan en el bundle: son PÚBLICAS.
# Nunca poner acá contraseñas, tokens, claves de DB ni de Mercado Pago.

# Origen de datos: "mock" (fixtures sintéticos, con banner visible) o "http" (API real).
# Sin valor: "mock" en desarrollo. El build de producción (build:hostinger) exige "http".
NEXT_PUBLIC_DATA_SOURCE=mock

# Base de la API de especialista (api-especialista). Obligatoria con DATA_SOURCE=http.
NEXT_PUBLIC_API_BASE_URL=

# Subcarpeta de publicación (vacío = raíz del dominio).
NEXT_PUBLIC_BASE_PATH=
